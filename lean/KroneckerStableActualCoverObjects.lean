import KroneckerBipartiteIsoSubrepresentations

/- Original module: KroneckerActualCoverClasses -/
section
set_option autoImplicit false
namespace KroneckerActualCoverClasses
open Module KroneckerPositiveSupportRestriction KroneckerFixedCoverReconstruction
open KroneckerBlockCoverExtension KroneckerReducedColorWords KroneckerWordParity
open KroneckerDeckDimensionClasses KroneckerCoverDeckTranslations

/-- An actual cover representation with its finitely supported dimension vector. -/
structure Object where
  representation : CoverRepresentation
  dimension : Word →₀ ℕ
  source_dimension : ∀ s, finrank ℂ (representation.SourceSpace s) = dimension s.val
  sink_dimension : ∀ t, finrank ℂ (representation.SinkSpace t) = dimension t.val

/-- Only genuine representation isomorphisms whose vertex relabeling is a
single color-preserving deck transformation generate this relation. -/
def DeckRelated (R S : Object) : Prop :=
  ∃ d : Deck, ∃ e : Iso R.representation.toRepresentation S.representation.toRepresentation,
    (∀ s, (e.sourceIndex s).val = d s.val) ∧
    (∀ t, (e.sinkIndex t).val = d t.val)

/-- A genuine deck isomorphism preserves the dimension vector with the same deck. -/
theorem deck_related_dimensions {R S : Object} (h : DeckRelated R S) :
    ∃ d : Deck, ∀ w, S.dimension (d w) = R.dimension w := by
  obtain ⟨d,e,hs,ht⟩ := h
  refine ⟨d,fun w => ?_⟩
  by_cases hw : parity w = 0
  · let s : CoverSource := ⟨w,hw⟩
    calc
      S.dimension (d w) = S.dimension (e.sourceIndex s).val := congrArg S.dimension (hs s).symm
      _ = finrank ℂ (S.representation.SourceSpace (e.sourceIndex s)) := (S.source_dimension _).symm
      _ = finrank ℂ (R.representation.SourceSpace s) := (e.source s).finrank_eq.symm
      _ = R.dimension w := R.source_dimension s
  · have hw' : parity w = 1 := by
      have hh : parity w < 2 := Nat.mod_lt _ (by omega)
      omega
    let t : CoverSink := ⟨w,hw'⟩
    calc
      S.dimension (d w) = S.dimension (e.sinkIndex t).val := congrArg S.dimension (ht t).symm
      _ = finrank ℂ (S.representation.SinkSpace (e.sinkIndex t)) := (S.sink_dimension _).symm
      _ = finrank ℂ (R.representation.SinkSpace t) := (e.sink t).finrank_eq.symm
      _ = R.dimension w := R.sink_dimension t

/-- Quotient generated by actual deck representation isomorphisms, not by
coincidence of dimension vectors. No geometric quotient is asserted. -/
abbrev ActualClass := Quot DeckRelated

def dimensionClass : ActualClass → DimensionClass :=
  Quot.lift (fun R => Quotient.mk dimensionSetoid R.dimension)
    (fun _ _ h => Quotient.sound (deck_related_dimensions h))


/-- Any family with injective dimension classes injects into actual classes. -/
theorem family_class_injective {ι : Type*} (F : ι → Object)
    (h : Function.Injective (fun i =>
      (Quotient.mk dimensionSetoid (F i).dimension : DimensionClass))) :
    Function.Injective (fun i => (Quot.mk DeckRelated (F i) : ActualClass)) := by
  intro i j hij
  exact h (congrArg dimensionClass hij)

end KroneckerActualCoverClasses
end

/- Original module: KroneckerBlockCoverIntrinsicStability -/
section
/- DEVELOPMENT SOURCE: certification status is recorded separately. -/
set_option autoImplicit false
namespace KroneckerBlockCoverIntrinsicStability
open Module KroneckerPositiveSupportRestriction KroneckerFixedCoverReconstruction
open KroneckerBlockCoverExtension KroneckerBlockCoverDimensions
open KroneckerCoverExtensionDimensions KroneckerReflectedSupportClasses KroneckerRetainedBlockSupport
open KroneckerBipartiteSubrepresentationRestriction
open scoped BigOperators

/-- An embedding captures a predicate exactly once it contains every vertex
satisfying that predicate. Zero-dimensional embedded vertices need not satisfy it. -/
noncomputable def predicateEmbeddingEquiv {A I : Type} (e : A ↪ I) (p : I → Prop)
    (hp : ∀ i, p i → i ∈ Set.range e) : {a : A // p (e a)} ≃ {i : I // p i} :=
  Equiv.ofBijective (fun a => ⟨e a.val,a.property⟩) (by
    constructor
    · intro a b h
      exact Subtype.ext (e.injective (congrArg Subtype.val h))
    · intro i
      obtain ⟨a,ha⟩ := hp i.val i.property
      exact ⟨⟨a,ha ▸ i.property⟩,Subtype.ext ha⟩)

/-- Finite-support sums can be taken over any finite embedded vertex family
containing the support. Extra zero-dimensional vertices contribute zero. -/
theorem positive_sum_eq_embedding_sum {A I : Type} [Fintype A]
    (e : A ↪ I) (d g : I → ℕ) [Fintype {i : I // 0 < d i}]
    (hz : ∀ i, i ∉ Set.range e → d i = 0)
    (hg : ∀ i, d i = 0 → g i = 0) :
    (∑ i : {i : I // 0 < d i}, g i.val) = ∑ a : A, g (e a) := by
  classical
  have hp : ∀ i, 0 < d i → i ∈ Set.range e := by
    intro i hi
    by_contra hn
    have hh := hz i hn
    omega
  let q := predicateEmbeddingEquiv e (fun i => 0 < d i) hp
  calc
    (∑ i : {i : I // 0 < d i}, g i.val) =
        ∑ a : {a : A // 0 < d (e a)}, g (e a.val) :=
      (Equiv.sum_comp q (fun i => g i.val)).symm
    _ = ∑ a : A, g (e a) := by
      apply Fintype.sum_of_injective (fun a : {a : A // 0 < d (e a)} => a.val)
        Subtype.val_injective
      · intro a ha
        apply hg
        by_contra hn
        exact ha ⟨⟨a,Nat.pos_of_ne_zero hn⟩,rfl⟩
      · intro a
        rfl

variable (X : ColoredBlock) (hT : (supportGraph X.block).IsTree) (r : X.block.Source)

/-- Old block subrepresentations and the new arbitrary-space global API describe
the same ALL-subrepresentation dictionary for this cover representation. -/
noncomputable def blockCoverSubrepEquiv :
    KroneckerLinearCoverBlocks.BlockSubrep X.block ≃
      Subrep (blockCoverRepresentation X hT r).toRepresentation :=
  (KroneckerZeroExtensionReindex.fixedCoverSubrepEquiv X hT r).trans
    (subrepFamilies (blockCoverRepresentation X hT r).toRepresentation).symm

theorem block_cover_subrep_source_at (U : KroneckerLinearCoverBlocks.BlockSubrep X.block)
    (s : X.block.Source) :
    finrank ℂ ((blockCoverSubrepEquiv X hT r U).source (sourceEmbedding X hT r s)) =
      finrank ℂ (U.source s) := by
  change finrank ℂ ((KroneckerBlockZeroExtension.extend
      (S := SourceComplement X hT r) (T := SinkComplement X hT r) U).source
      ((KroneckerBlockCoverExtension.sourceLabel X hT r).symm
        (KroneckerBlockCoverExtension.sourceLabel X hT r (.inl s)))) = _
  exact congrArg (fun i => finrank ℂ ((KroneckerBlockZeroExtension.extend
    (S := SourceComplement X hT r) (T := SinkComplement X hT r) U).source i))
    ((KroneckerBlockCoverExtension.sourceLabel X hT r).symm_apply_apply (.inl s))

theorem block_cover_subrep_sink_at (U : KroneckerLinearCoverBlocks.BlockSubrep X.block)
    (t : X.block.Sink) :
    finrank ℂ ((blockCoverSubrepEquiv X hT r U).sink (sinkEmbedding X hT r t)) =
      finrank ℂ (U.sink t) := by
  change finrank ℂ ((KroneckerBlockZeroExtension.extend
      (S := SourceComplement X hT r) (T := SinkComplement X hT r) U).sink
      ((KroneckerBlockCoverExtension.sinkLabel X hT r).symm
        (KroneckerBlockCoverExtension.sinkLabel X hT r (.inl t)))) = _
  exact congrArg (fun j => finrank ℂ ((KroneckerBlockZeroExtension.extend
    (S := SourceComplement X hT r) (T := SinkComplement X hT r) U).sink j))
    ((KroneckerBlockCoverExtension.sinkLabel X hT r).symm_apply_apply (.inl t))

theorem block_cover_source_zero_outside (s : CoverSource)
    (h : s ∉ Set.range (sourceEmbedding X hT r)) :
    finrank ℂ ((blockCoverRepresentation X hT r).SourceSpace s) = 0 := by
  rw [block_cover_source_dimension]
  exact KroneckerFiniteWeightedImages.weightedImage_outside _ _
    (source_complement_outside X hT r ⟨s,h⟩)

theorem block_cover_sink_zero_outside (t : CoverSink)
    (h : t ∉ Set.range (sinkEmbedding X hT r)) :
    finrank ℂ ((blockCoverRepresentation X hT r).SinkSpace t) = 0 := by
  rw [block_cover_sink_dimension]
  exact KroneckerFiniteWeightedImages.weightedImage_outside _ _
    (sink_complement_outside X hT r ⟨t,h⟩)

/-- The finite positive support is derived from the certified dimension vector. -/
noncomputable def blockCoverSourceFintype :
    Fintype (PositiveSource (blockCoverRepresentation X hT r).toRepresentation) := by
  letI : Finite (PositiveSource (blockCoverRepresentation X hT r).toRepresentation) :=
    cover_positive_sources_finite (blockCoverRepresentation X hT r) (coverDimensions X hT r)
      (block_cover_source_dimension X hT r)
  exact Fintype.ofFinite _

noncomputable def blockCoverSinkFintype :
    Fintype (PositiveSink (blockCoverRepresentation X hT r).toRepresentation) := by
  letI : Finite (PositiveSink (blockCoverRepresentation X hT r).toRepresentation) :=
    cover_positive_sinks_finite (blockCoverRepresentation X hT r) (coverDimensions X hT r)
      (block_cover_sink_dimension X hT r)
  exact Fintype.ofFinite _

variable [Fintype (PositiveSource (blockCoverRepresentation X hT r).toRepresentation)]
variable [Fintype (PositiveSink (blockCoverRepresentation X hT r).toRepresentation)]

theorem block_cover_intrinsic_source_size (U : KroneckerLinearCoverBlocks.BlockSubrep X.block) :
    supportSourceSize (blockCoverSubrepEquiv X hT r U) = KroneckerLinearCoverBlocks.sourceSize U := by
  rw [supportSourceSize, positive_sum_eq_embedding_sum (sourceEmbedding X hT r)
    (fun s => finrank ℂ ((blockCoverRepresentation X hT r).SourceSpace s))
    (fun s => finrank ℂ ((blockCoverSubrepEquiv X hT r U).source s))
    (block_cover_source_zero_outside X hT r)
    (source_subrep_dimension_zero (blockCoverSubrepEquiv X hT r U))]
  simp only [block_cover_subrep_source_at, KroneckerLinearCoverBlocks.sourceSize]

theorem block_cover_intrinsic_sink_size (U : KroneckerLinearCoverBlocks.BlockSubrep X.block) :
    supportSinkSize (blockCoverSubrepEquiv X hT r U) = KroneckerLinearCoverBlocks.sinkSize U := by
  rw [supportSinkSize, positive_sum_eq_embedding_sum (sinkEmbedding X hT r)
    (fun t => finrank ℂ ((blockCoverRepresentation X hT r).SinkSpace t))
    (fun t => finrank ℂ ((blockCoverSubrepEquiv X hT r U).sink t))
    (block_cover_sink_zero_outside X hT r)
    (sink_subrep_dimension_zero (blockCoverSubrepEquiv X hT r U))]
  simp only [block_cover_subrep_sink_at, KroneckerLinearCoverBlocks.sinkSize]

theorem block_cover_intrinsic_source_dimension :
    sourceDimension (restriction (blockCoverRepresentation X hT r).toRepresentation) =
      KroneckerLinearCoverBlocks.sourceDimension X.block := by
  change (∑ s : PositiveSource (blockCoverRepresentation X hT r).toRepresentation,
    finrank ℂ ((blockCoverRepresentation X hT r).SourceSpace s.val)) = _
  rw [positive_sum_eq_embedding_sum (sourceEmbedding X hT r)
    (fun s => finrank ℂ ((blockCoverRepresentation X hT r).SourceSpace s))
    (fun s => finrank ℂ ((blockCoverRepresentation X hT r).SourceSpace s))
    (block_cover_source_zero_outside X hT r) (fun _ h => h)]
  apply Finset.sum_congr rfl
  intro s _
  rw [block_cover_source_dimension]
  exact coverDimensions_at X hT r (.inl s)

theorem block_cover_intrinsic_sink_dimension :
    sinkDimension (restriction (blockCoverRepresentation X hT r).toRepresentation) =
      Fintype.card X.block.Sink := by
  change (∑ t : PositiveSink (blockCoverRepresentation X hT r).toRepresentation,
    finrank ℂ ((blockCoverRepresentation X hT r).SinkSpace t.val)) = _
  rw [positive_sum_eq_embedding_sum (sinkEmbedding X hT r)
    (fun t => finrank ℂ ((blockCoverRepresentation X hT r).SinkSpace t))
    (fun t => finrank ℂ ((blockCoverRepresentation X hT r).SinkSpace t))
    (block_cover_sink_zero_outside X hT r) (fun _ h => h)]
  have hd (t : X.block.Sink) : finrank ℂ ((blockCoverRepresentation X hT r).SinkSpace
      (sinkEmbedding X hT r t)) = 1 := by
    rw [block_cover_sink_dimension]
    exact coverDimensions_at X hT r (.inr t)
  simp only [hd, Finset.sum_const, Finset.card_univ, smul_eq_mul, mul_one]

/-- The constructed cover representation satisfies the intrinsic global King
condition exactly when the original block is stable. No positivity assumption
on every source fiber is added. -/
theorem block_cover_support_stability_iff :
    SupportKingStable (blockCoverRepresentation X hT r).toRepresentation ↔
      KroneckerGluedSubrepEquivalence.BlockKingStable X.block := by
  constructor
  · intro h U
    simpa only [block_cover_intrinsic_source_size,block_cover_intrinsic_sink_size,
      block_cover_intrinsic_source_dimension,block_cover_intrinsic_sink_dimension]
      using h (blockCoverSubrepEquiv X hT r U)
  · intro h U
    obtain ⟨W,rfl⟩ := (blockCoverSubrepEquiv X hT r).surjective U
    simpa only [block_cover_intrinsic_source_size,block_cover_intrinsic_sink_size,
      block_cover_intrinsic_source_dimension,block_cover_intrinsic_sink_dimension]
      using h W

omit [Fintype (PositiveSource (blockCoverRepresentation X hT r).toRepresentation)]
    [Fintype (PositiveSink (blockCoverRepresentation X hT r).toRepresentation)] in
/-- A concrete intrinsically stable cover representation is obtained from every
stable colored tree block, with finite support supplied by its dimension vector. -/
theorem block_cover_intrinsically_stable
    (hB : KroneckerGluedSubrepEquivalence.BlockKingStable X.block) :
    letI := blockCoverSourceFintype X hT r
    letI := blockCoverSinkFintype X hT r
    SupportKingStable (blockCoverRepresentation X hT r).toRepresentation := by
  let := blockCoverSourceFintype X hT r
  let := blockCoverSinkFintype X hT r
  exact (block_cover_support_stability_iff X hT r).mpr hB

end KroneckerBlockCoverIntrinsicStability
end

/- Original module: KroneckerStableActualCoverObjects -/
section
set_option autoImplicit false
namespace KroneckerActualCoverClasses
open Module KroneckerPositiveSupportRestriction KroneckerFixedCoverReconstruction
open KroneckerBlockCoverExtension KroneckerBlockCoverDimensions
open KroneckerReflectedSupportClasses KroneckerRetainedBlockSupport
open KroneckerBipartiteSubrepresentationRestriction KroneckerBlockCoverIntrinsicStability

noncomputable def objectSourceFintype (R : Object) :
    Fintype (PositiveSource R.representation.toRepresentation) := by
  letI := cover_positive_sources_finite R.representation R.dimension R.source_dimension
  exact Fintype.ofFinite _
noncomputable def objectSinkFintype (R : Object) :
    Fintype (PositiveSink R.representation.toRepresentation) := by
  letI := cover_positive_sinks_finite R.representation R.dimension R.sink_dimension
  exact Fintype.ofFinite _

def ObjectStable (R : Object) : Prop :=
  letI := objectSourceFintype R
  letI := objectSinkFintype R
  SupportKingStable R.representation.toRepresentation

noncomputable def blockObject (X : ColoredBlock)
    (hT : (supportGraph X.block).IsTree) (r : X.block.Source) : Object where
  representation := blockCoverRepresentation X hT r
  dimension := coverDimensions X hT r
  source_dimension := block_cover_source_dimension X hT r
  sink_dimension := block_cover_sink_dimension X hT r

/-- The numerical family now supplies actual stable objects on the fixed cover. -/
theorem blockObject_stable (X : ColoredBlock)
    (hT : (supportGraph X.block).IsTree) (r : X.block.Source)
    (hB : KroneckerGluedSubrepEquivalence.BlockKingStable X.block) :
    ObjectStable (blockObject X hT r) := by
  exact block_cover_intrinsically_stable X hT r hB



end KroneckerActualCoverClasses
end
