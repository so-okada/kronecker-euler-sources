import KroneckerLogic

/-! Integral real-root pairs generated by the actual reflection dimension
recurrence. Strict growth prevents truncated subtraction from changing the
intended linear recurrence for m≥3. -/
noncomputable section
set_option autoImplicit false
namespace KroneckerRootPairRecurrence

def pair (m : ℕ) : ℕ → ℕ × ℕ
  | 0 => (0,1)
  | n+1 => ((pair m n).2,m*(pair m n).2-(pair m n).1)

theorem growth (m : ℕ) (hm : 3≤m) (n : ℕ) : (pair m n).1<(pair m n).2 := by
  induction n with
  | zero => simp [pair]
  | succ n ih =>
    change (pair m n).2<m*(pair m n).2-(pair m n).1
    have hmul : 3*(pair m n).2≤m*(pair m n).2 := Nat.mul_le_mul_right _ hm
    omega

theorem source_ge_index (m : ℕ) (hm : 3≤m) (n : ℕ) : n≤(pair m n).1 := by
  induction n with
  | zero => simp [pair]
  | succ n ih =>
    change n+1≤(pair m n).2
    have h := growth m hm n
    omega

theorem untruncated (m : ℕ) (hm : 3≤m) (n : ℕ) :
    (pair m n).1+(pair m (n+1)).2=m*(pair m n).2 := by
  change (pair m n).1+(m*(pair m n).2-(pair m n).1)=_
  have h := growth m hm n
  have hmul : (pair m n).2≤m*(pair m n).2 := Nat.le_mul_of_pos_left _ (by omega)
  omega
end KroneckerRootPairRecurrence
